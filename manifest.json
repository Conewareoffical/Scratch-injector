{
  "manifest_version": 3,
  "name": "Scratch Memory Injector",
  "version": "4.0",
  "description": "Injects a .sprite3 file locally into any running Scratch game.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://scratch.mit.edu/projects/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}